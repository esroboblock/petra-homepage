---
import { businessAreas, primaryService } from '../data/site';
---

<section id="services" class="section-grid" aria-labelledby="services-title">
  <h2 id="services-title">서비스</h2>
  <div class="service-content">
    <article>
      <h3>{primaryService.name}</h3>
      <p>{primaryService.description}</p>
    </article>
    <div class="business-areas">
      <h3>사업 분야</h3>
      <ul>
        {businessAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .service-content {
    display: grid;
    gap: 2.5rem;
  }

  article p {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .business-areas {
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .business-areas h3 {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  ul {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
  }

  li::marker {
    color: var(--color-accent);
  }
</style>
