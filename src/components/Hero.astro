---
import { company, primaryService } from '../data/site';
---

<section id="hero" aria-labelledby="hero-title">
  <p class="eyebrow">전자부품 수급·유통</p>
  <h1 id="hero-title">{company.englishName}</h1>
  <div class="introduction">
    <p>{primaryService.description}</p>
    <a class="button-link" href="#contact">문의하기</a>
  </div>
</section>

<style>
  .eyebrow {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  h1 {
    margin-block: 1.5rem 2rem;
    font-family: var(--font-wordmark);
    font-size: clamp(5rem, 17vw, 15rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .introduction {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .introduction p {
    max-width: 34rem;
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--color-muted);
  }
</style>
