---
import { company } from '../data/site';
---

<section id="about" aria-labelledby="about-title">
  <h2 id="about-title">회사 소개</h2>
  <dl>
    <div>
      <dt>상호</dt>
      <dd>{company.legalName}</dd>
    </div>
    <div>
      <dt>설립</dt>
      <dd>{company.founded}</dd>
    </div>
    <div>
      <dt>대표</dt>
      <dd>{company.representative}</dd>
    </div>
    <div>
      <dt>소재지</dt>
      <dd>{company.location}</dd>
    </div>
  </dl>
</section>
